<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pr_root"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="92dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal">
        <ImageView
            android:id="@+id/pr_ring"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/pr_bars"
            android:layout_width="92dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/pr_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#E0C15A"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/pr_add"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_add_bg"
                android:gravity="center"
                android:text="+"
                android:textColor="#1A212A"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/pr_row_0"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/pr_cb_0"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_check_open"
                android:contentDescription="Mark task done" />
            <TextView
                android:id="@+id/pr_name_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:gravity="center_vertical"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F3EDE0"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/pr_row_1"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/pr_cb_1"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_check_open"
                android:contentDescription="Mark task done" />
            <TextView
                android:id="@+id/pr_name_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:gravity="center_vertical"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F3EDE0"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/pr_row_2"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/pr_cb_2"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_check_open"
                android:contentDescription="Mark task done" />
            <TextView
                android:id="@+id/pr_name_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:gravity="center_vertical"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F3EDE0"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
