<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pp_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">
    <TextView
        android:id="@+id/pp_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PEOPLE TO FOLLOW UP"
        android:textColor="#93A0AD"
        android:textSize="10sp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/pp_row_0"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/pp_avatar_0"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <LinearLayout
            android:id="@+id/pp_text_0"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/pp_name_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F3EDE0"
                android:textSize="14sp"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/pp_sub_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#93A0AD"
                android:textSize="11sp"
                />
        </LinearLayout>
        <ImageView
            android:id="@+id/pp_call_0"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_circle_card"
            android:contentDescription="Call"
            android:padding="8dp"
            android:src="@drawable/ic_w_phone" />
        <ImageView
            android:id="@+id/pp_msg_0"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/widget_circle_card"
            android:contentDescription="Message"
            android:padding="8dp"
            android:src="@drawable/ic_w_message" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/pp_row_1"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/pp_avatar_1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <LinearLayout
            android:id="@+id/pp_text_1"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/pp_name_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F3EDE0"
                android:textSize="14sp"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/pp_sub_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#93A0AD"
                android:textSize="11sp"
                />
        </LinearLayout>
        <ImageView
            android:id="@+id/pp_call_1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_circle_card"
            android:contentDescription="Call"
            android:padding="8dp"
            android:src="@drawable/ic_w_phone" />
        <ImageView
            android:id="@+id/pp_msg_1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/widget_circle_card"
            android:contentDescription="Message"
            android:padding="8dp"
            android:src="@drawable/ic_w_message" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/pp_row_2"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/pp_avatar_2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <LinearLayout
            android:id="@+id/pp_text_2"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/pp_name_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F3EDE0"
                android:textSize="14sp"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/pp_sub_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#93A0AD"
                android:textSize="11sp"
                />
        </LinearLayout>
        <ImageView
            android:id="@+id/pp_call_2"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_circle_card"
            android:contentDescription="Call"
            android:padding="8dp"
            android:src="@drawable/ic_w_phone" />
        <ImageView
            android:id="@+id/pp_msg_2"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/widget_circle_card"
            android:contentDescription="Message"
            android:padding="8dp"
            android:src="@drawable/ic_w_message" />
    </LinearLayout>
</LinearLayout>
