<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gl_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">
    <TextView
        android:fontFamily="@font/quicksand"
        android:id="@+id/gl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GOALS TODAY"
        android:textColor="#93A0AD"
        android:textSize="10sp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/gl_row_0"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/gl_ring_0"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1">
            <TextView
        android:fontFamily="@font/quicksand"
                android:id="@+id/gl_name_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F3EDE0"
                android:textSize="13sp"
                android:textStyle="bold"
                />
            <TextView
        android:fontFamily="@font/quicksand"
                android:id="@+id/gl_sub_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#93A0AD"
                android:textSize="11sp"
                />
        </LinearLayout>
        <TextView
        android:fontFamily="@font/quicksand"
            android:id="@+id/gl_plus_0"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_add_bg"
            android:gravity="center"
            android:text="+"
            android:textColor="#1A212A"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/gl_row_1"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/gl_ring_1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1">
            <TextView
        android:fontFamily="@font/quicksand"
                android:id="@+id/gl_name_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F3EDE0"
                android:textSize="13sp"
                android:textStyle="bold"
                />
            <TextView
        android:fontFamily="@font/quicksand"
                android:id="@+id/gl_sub_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#93A0AD"
                android:textSize="11sp"
                />
        </LinearLayout>
        <TextView
        android:fontFamily="@font/quicksand"
            android:id="@+id/gl_plus_1"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_add_bg"
            android:gravity="center"
            android:text="+"
            android:textColor="#1A212A"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/gl_row_2"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/gl_ring_2"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1">
            <TextView
        android:fontFamily="@font/quicksand"
                android:id="@+id/gl_name_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F3EDE0"
                android:textSize="13sp"
                android:textStyle="bold"
                />
            <TextView
        android:fontFamily="@font/quicksand"
                android:id="@+id/gl_sub_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#93A0AD"
                android:textSize="11sp"
                />
        </LinearLayout>
        <TextView
        android:fontFamily="@font/quicksand"
            android:id="@+id/gl_plus_2"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_add_bg"
            android:gravity="center"
            android:text="+"
            android:textColor="#1A212A"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
