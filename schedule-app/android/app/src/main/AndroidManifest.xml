<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- @capacitor/geolocation requests these at runtime via its
         @CapacitorPlugin permissions annotation, but Capacitor plugins using
         that mechanism don't auto-merge the underlying manifest permission —
         the consuming app has to declare it itself, or the runtime request
         can't be granted at all. Used for the Map's "my location", geocoding
         a contact's address, and arrival reminders. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android 12+ (S) gates *exact*-time alarms behind this separate
         permission from plain notification permission. Without it,
         @capacitor/local-notifications still schedules reminders (see
         LocalNotificationManager.setExactIfPossible's fallback), but Android
         defers them to its own Doze maintenance windows instead of firing
         at the requested time — which reads as "reminders don't work when
         the app is closed" even though they technically do, just late.
         This is a "special" permission: declaring it doesn't show a
         install-time prompt, and on Android 13+ it isn't auto-granted —
         the user still has to flip it on via Settings (see
         MorePage.jsx's "Enable exact-time reminders" button, which opens
         that screen directly through the plugin's
         changeExactNotificationSetting()). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
