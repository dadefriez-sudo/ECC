{
  "name": "keystone-backend",
  "version": "0.1.0",
  "private": true,
  "author": "KeyStone Software",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "postinstall": "npm run db:generate",
    "db:generate": "prisma generate --config prisma.config.mjs",
    "db:migrate": "prisma migrate dev --config prisma.config.mjs",
    "db:deploy": "prisma migrate deploy --config prisma.config.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@apple/app-store-server-library": "^3.1.0",
    "@clerk/express": "^2.1.44",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "googleapis": "^174.0.1",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "prisma": "^7.9.0"
  }
}
