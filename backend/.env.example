# Postgres connection string. In production this comes from Render/Railway's
# managed Postgres add-on. For local dev, see backend/README.md.
DATABASE_URL="postgresql://user:password@localhost:5432/keystone_dev?schema=public"

# Clerk Dashboard -> your app -> API Keys
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Stripe Dashboard -> Developers -> API keys (use test-mode keys until launch)
STRIPE_SECRET_KEY="sk_test_..."
# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID for the one-time Pro purchase (Stripe Dashboard -> Product
# catalog). This must be a **one-time** price, not a recurring one —
# checkout runs in `payment` mode and a recurring price will be rejected.
# STRIPE_PRICE_ID is accepted as a fallback name.
STRIPE_PRICE_ID_LIFETIME="price_..."

# In-app purchase verification — the native app sells Pro through StoreKit
# / Play Billing instead of Stripe Checkout. Both are optional: leave a
# platform's vars unset and its purchases simply can't verify (a 400, not a
# crash) until they're set. See schedule-app/appstore-assets/IAP.md.
#
# App Store Connect -> your app -> App Information -> Bundle ID.
APPLE_BUNDLE_ID="com.keystone.app"
# App Store Connect -> your app -> App Information -> Apple ID (the numeric
# one, not the bundle id). Only needed to verify PRODUCTION purchases —
# leave unset and sandbox/TestFlight purchases still verify.
APPLE_APP_APPLE_ID=""
# Base64 of Apple's own root CA certificate (DER format), from Apple's
# certificate authority page (search Apple's developer support site for
# "Apple Root Certificates" — download "Apple Root CA - G3", then
# `base64 -i AppleRootCA-G3.cer`). Comma-separate more than one if rotating.
APPLE_ROOT_CERT_BASE64=""
# Google Play Console -> your app -> App integrity / Setup -> API access ->
# create a service account with the Play Developer API "View app
# information" permission, download its JSON key, and paste the whole file
# contents here as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Google Play Console -> your app -> App integrity -> Package name.
GOOGLE_PLAY_PACKAGE_NAME="com.keystone.app"
# The one-time Pro product's id, as created in App Store Connect and Play
# Console — same value in both by convention, but they don't have to match.
PRO_PRODUCT_ID_IOS="keystone_pro_lifetime"
PRO_PRODUCT_ID_ANDROID="keystone_pro_lifetime"

# One-time Google Calendar / Contacts import (read-only, see
# src/routes/google.js) — Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID (Web application). Enable the "Google
# Calendar API" and "People API" first, and add the OAuth consent screen
# scopes .../auth/calendar.readonly and .../auth/contacts.readonly. Optional:
# leave unset and the "Sign in with Google" button just errors instead of
# working, same as the Stripe/IAP vars above.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match an "Authorized redirect URI" on that OAuth client —
# your deployed backend URL + /api/google/callback.
GOOGLE_REDIRECT_URI="http://localhost:4000/api/google/callback"

# Anthropic Console -> API keys. Powers the in-app assistant (the chat
# bubble). Optional: leave it unset and the bubble simply doesn't appear.
# This key must never be copied into the frontend's own .env — anything in
# the PWA bundle is public.
ANTHROPIC_API_KEY="sk-ant-..."

# The deployed frontend's origin (CORS + redirect URLs). Use your Vite dev
# server URL (e.g. http://localhost:5173) while developing locally.
FRONTEND_URL="http://localhost:5173"

PORT=4000
